 "subtitles": [
  {
   "t": 0.3,
   "end": 4.0,
   "text": "**شما** انسان‌ها می‌گین از **منِ** پول، همه‌چیز **خراب** شده."
  },
  {
   "t": 4.0,
   "end": 6.4,
   "text": "ولی دلیلِ **من** علیه شما **مستندتره؛**"
  },
  {
   "t": 6.4,
   "end": 10.6,
   "text": "چون من فقط **«ممکنه»** وسوسه کنم، اما شما **انجام** **دادید.**"
  },
  {
   "t": 11.2,
   "end": 15.6,
   "text": "ثروتِ فقط **۱** **درصد** از شما، بیشتر از دارایی **۹۵** **درصد** بقیه‌ست."
  },
  {
   "t": 15.6,
   "end": 19.2,
   "text": "و من رو توی **گاوصندوق** حبس کردین."
  },
  {
   "t": 19.8,
   "end": 23.2,
   "text": "**انسولین** رو مخترعش به **یک** **دلار** فروخت؛"
  },
  {
   "t": 23.2,
   "end": 27.4,
   "text": "شما همون رو **۳۰۰** **دلار** به بیمار فروختین."
  }
 ],
