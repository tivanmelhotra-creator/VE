 "subtitles": [
  {
   "t": 0.3,
   "end": 3.6,
   "text": "یک **قطره** نفت؛"
  },
  {
   "t": 3.6,
   "end": 7.0,
   "text": "که قرار بود **پول** همه‌ی ما باشه."
  },
  {
   "t": 7.6,
   "end": 11.4,
   "text": "زیرِ **خونه‌ی** ما، دریایی از **ثروت** خوابیده."
  },
  {
   "t": 11.4,
   "end": 14.6,
   "text": "ولی **لوله** مستقیم می‌ره یه جای **دیگه.**"
  },
  {
   "t": 15.4,
   "end": 19.0,
   "text": "قانون اساسی می‌گه این ثروت **عمومیه.**"
  },
  {
   "t": 19.0,
   "end": 22.4,
   "text": "**اصل ۴۵** — سیاه روی سفید."
  },
  {
   "t": 23.4,
   "end": 27.0,
   "text": "دولت **نفت** رو می‌فروشه، **یارانه** می‌ده،"
  },
  {
   "t": 27.0,
   "end": 30.4,
   "text": "و مالیاتش رو **دوباره** از شما می‌گیره."
  },
  {
   "t": 31.4,
   "end": 35.0,
   "text": "صورت‌حسابِ یک لیتر بنزینِ **«ارزون»:**"
  },
  {
   "t": 35.0,
   "end": 38.8,
   "text": "از **۱۵۰۰** تومن رسید به **۳۰۰۰.**"
  },
  {
   "t": 39.8,
   "end": 43.4,
   "text": "یک طرف: **پول** — یه تکه کاغذ."
  },
  {
   "t": 43.4,
   "end": 47.0,
   "text": "طرفِ دیگه: **نان،** **دارو،** **جنگل.**"
  },
  {
   "t": 48.0,
   "end": 52.0,
   "text": "و گزارشِ رسمی گفت: **هیچ** مدرکی پیدا نشد."
  },
  {
   "t": 52.0,
   "end": 56.0,
   "text": "پرونده **باز** می‌مونه."
  }
 ],
