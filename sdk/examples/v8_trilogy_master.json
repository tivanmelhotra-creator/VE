  {
   "t": 0.3,
   "end": 3.6,
   "text": "یک **قطره** نفت؛"
  },
  {
   "t": 3.6,
   "end": 7.0,
   "text": "که قرار بود **پول** همه‌ی ما باشه."
  },
  {
   "t": 8.4,
   "end": 12.8,
   "text": "زیرِ **خونه‌ی** ما، دریایی از **ثروت** خوابیده."
  },
  {
   "t": 15.6,
   "end": 18.7,
   "text": "قیمتِ **واقعیِ** یک لیتر بنزین چنده؟"
  },
  {
   "t": 18.9,
   "end": 22.5,
   "text": "از **۱۵۰۰** تومن رسید به **۳۰۰۰.**"
  },
  {
   "t": 22.9,
   "end": 26.7,
   "text": "سه چیز توی این قیمت **پنهانه.**"
  },
  {
   "t": 27.5,
   "end": 30.9,
   "text": "و سهمِ شما از نفت؟ **صفر.**"
  },
  {
   "t": 34.1,
   "end": 36.4,
   "text": "شما می‌گین **پول** خرابتون کرد."
  },
  {
   "t": 36.6,
   "end": 39.4,
   "text": "ولی من فقط ممکنه وسوسه کنم؛"
  },
  {
   "t": 39.6,
   "end": 42.2,
   "text": "این **شما** بودید که **انجام** دادید."
  },
  {
   "t": 43.3,
   "end": 46.3,
   "text": "یک درصد از شما، بیشتر از **نود و پنج** درصد."
  }
