 "subtitles": [
  {
   "t": 0.3,
   "end": 3.6,
   "text": "یک **قطره** نفت؛"
  },
  {
   "t": 3.6,
   "end": 7.0,
   "text": "که قرار بود **پول** همه‌ی ما باشه."
  },
  {
   "t": 8.4,
   "end": 12.8,
   "text": "زیرِ **خونه‌ی** ما، دریایی از **ثروت** خوابیده."
  },
  {
   "t": 15.6,
   "end": 18.7,
   "text": "قیمتِ **واقعیِ** یک لیتر بنزین چنده؟"
  },
  {
   "t": 18.9,
   "end": 22.5,
   "text": "از **۱۵۰۰** تومن رسید به **۳۰۰۰.**"
  },
  {
   "t": 22.9,
   "end": 26.7,
   "text": "سه چیز توی این قیمت **پنهانه.**"
  },
  {
   "t": 27.5,
   "end": 30.9,
   "text": "و سهمِ شما از نفت؟ **صفر.**"
  },
  {
   "t": 31.76,
   "end": 34.16,
   "text": "فکر می‌کنی ساختن یه موشن حرفه‌ای **امکان نداره؟**"
  },
  {
   "t": 34.37,
   "end": 34.91,
   "text": "**اینو** ببین."
  },
  {
   "t": 35.13,
   "end": 36.08,
   "text": "همه‌چی با یه **پرامپت** شروع می‌شه."
  },
  {
   "t": 36.04,
   "end": 39.14,
   "text": "دیگه لازم نیست ساعت‌ها توی افترافکت تایم‌لاین رو **باز** کنی."
  },
  {
   "t": 39.22,
   "end": 41.22,
   "text": "منحنی سرعت، خودش **نرم** می‌شه."
  },
  {
   "t": 41.64,
   "end": 45.1,
   "text": "**شکل‌های سیال،** المان سه‌بعدی، و حرکت روان دوربین."
  },
  {
   "t": 45.66,
   "end": 47.12,
   "text": "ببین حروف چطوری **کش** میان!"
  },
  {
   "t": 47.44,
   "end": 49.08,
   "text": "**تایپوگرافی** که از صفحه بیرون می‌زنه."
  },
  {
   "t": 49.24,
   "end": 51.22,
   "text": "دوربین رو روشن کن، هر **فریم** یه داستانه."
  },
  {
   "t": 51.42,
   "end": 54.26,
   "text": "**شوخیت** گرفته؟ نه! این فقط یه فایل جیسونه."
  },
  {
   "t": 54.16,
   "end": 55.54,
   "text": "چهار سبک، یه موتور."
  },
  {
   "t": 55.76,
   "end": 56.6,
   "text": "**کافیه** شروع کنی."
  }
 ],
